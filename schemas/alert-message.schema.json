{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alert Message",
  "type": "object",
  "properties": {
    "alertId": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "alertId",
    "severity",
    "message"
  ],
  "additionalProperties": true
}
